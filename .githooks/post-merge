#!/usr/bin/env bash
set -e

# Only run cleanup on main branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "main" ]; then
    exit 0
fi

echo ""
echo "🧹 Post-merge cleanup on main branch..."

# Prune deleted remote branches
echo "✂️  Pruning deleted remote branches..."
git fetch --prune

# Delete local branches whose upstream is gone. Uses for-each-ref rather than
# parsing `git branch -vv`, whose `*` and `+` markers push the name out of $1.
echo "🗑️  Cleaning up merged branches..."
GONE_BRANCHES=$(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads |
    awk '$2 == "[gone]" {print $1}')

if [ -n "$GONE_BRANCHES" ]; then
    echo "$GONE_BRANCHES" | while read -r branch; do
        if git branch -D "$branch" >/dev/null 2>&1; then
            echo "  Deleted: $branch"
        else
            echo "  Couldn't delete: $branch (checked out in a worktree?)"
        fi
    done
    echo "✅ Cleanup complete!"
else
    echo "✨ No branches to clean up!"
fi

echo ""
echo "Branches remaining:"
git branch
echo ""
